# ── Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# LLM 모델 설정
LLM_MODEL=claude-sonnet-4-6

# ── Database ───────────────────────────────────────────────────────
POSTGRES_USER=devteam
POSTGRES_PASSWORD=devteam
POSTGRES_DB=devteam

# ── GitHub (Release Agent 용) ──────────────────────────────────────
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-org/your-repo

# ── App Store 배포 (Release Agent) ────────────────────────────────
# Apple
APPLE_ID=your@email.com
APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Google Play
GOOGLE_PLAY_JSON_KEY_PATH=/workspace/secrets/play-store-key.json

# ── Slack 알림 (선택) ──────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── 승인자 설정 ────────────────────────────────────────────────────
APPROVER_EMAIL=jayeun22@gmail.com

# ── Firebase Test Lab (QA 에이전트, Robo 무작위 테스트) ─────────────
GCP_TEST_LAB_KEY_PATH=/path/to/service-account-key.json

# ── Atlassian (Jira/Confluence 연동) ────────────────────────────────
ATLASSIAN_EMAIL=your@email.com
ATLASSIAN_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
ATLASSIAN_DOMAIN=your-domain.atlassian.net
JIRA_PROJECT_KEY=ATM
CONFLUENCE_SPACE_KEY=ATM

# ── 외부 공개 URL (Jira 코멘트에 남기는 디자인 목업/산출물 링크용) ──
# web/server.js가 "/"(SPA)와 "/_next/*" 말고는 전부 orchestrator로 프록시하므로
# ngrok이 뚫고 있는 이 도메인으로 /design-file/*, /recordings/* 등이 그대로 열림.
PUBLIC_BASE_URL=https://thrive-estate-vindicate.ngrok-free.dev
